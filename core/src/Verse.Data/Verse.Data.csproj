<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Verse.Shared\Verse.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Security: pin the native SQLite for the whole solution.
         CVE-2025-6965 / GHSA-2m69-gcr7-jv3q (aggregate terms > columns ->
         memory corruption, fixed in SQLite 3.50.2) was the original trigger:
         EF Core's default at the time (bundle 2.1.11) embedded the affected
         3.49.1. 3.0.5 resolves to SQLite 3.53.4 (verified from build
         output), above the fix line. EF Core 10.0.14's own default
         (bundle 2.1.13 -> 3.53.3) is patched as well, so the pin now
         documents an explicit native version instead of working around a
         vulnerable default. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

</Project>
