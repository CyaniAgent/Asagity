%% Asagity Verse backend architecture — updated 2026-10-25 (Dev).
%% Reflects the Go→.NET migration mid-state (docs/architecture/tech-stack-audit.md, S1–S4 done).
%% Layering red line: public API + business modules in .NET; core services (event bus,
%% websocket push, search, federation) stay in Go. Legend at the bottom marks
%% live / 501-stub / placeholder-planned components.

flowchart TD
    %% ============ External ============
    subgraph External["External Layer"]
        Web["Web Client (React SPA :2000)\n/api/* → Go engine :2048 (primary)\n/api-net/* → .NET API :2050 (mirror + fallback)\n/ws/* → Go engine :2048"]
        Fediverse["Fediverse Peers\n(Mastodon / Misskey / Pleroma)"]
    end

    %% ============ Management tooling ============
    subgraph Management["Verse.Cli — versetool (Go)"]
        VerseTool["verse CLI\n--mode=databaseless | lite | production\nstart · stop · restart · status · logs\nhealth · doctor · db · app · interactive menu"]
        Runner["internal/runner\ndual-process supervision:\ngo build verse-engine · dotnet build Verse.Api\ninjects SERVER_PORT + VERSE_API_PORT"]
        Doctor["internal/doctor\nenvironment + DB self-healing"]
        ModuleMgr["internal/modulemgr\n.aap app registry (list / enable / disable)"]
        EngineApi["internal/engineapi + process + mode + config\nCLI ↔ engine client · lifecycle · runtime mode"]
        VerseTool --> Runner
        VerseTool --> Doctor
        VerseTool --> ModuleMgr
        VerseTool --> EngineApi
    end

    %% ============ .NET side ============
    subgraph DotNetSide[".NET Side — public API + business modules (src/Verse.slnx)"]
        Api["Verse.Api (ASP.NET Core :2050, VERSE_API_PORT)\nstatic composition of 9 modules in Program.cs\nDotEnv → JwtMiddleware → ScopeGuardMiddleware\nseeds admin/developer account on boot"]
        Shared["Verse.Shared\nApiEnvelope · CurrentUser · Scopes\nRequireScope guards (single scope truth: docs/api/permissions.md)"]

        subgraph DotNetModules["Verse.Modules — 9 domains, migration S1–S8"]
            direction LR
            InstanceDotNet["Instance — live\nmeta · healthz · admin"]
            UserDotNet["User — live\nprofile · pubid change + monthly quota"]
            ShellDotNet["Shell — live\nping · meta · github\ntermity guest-code / guest-verify"]
            MusicDotNet["Music — live (AAP sample)\nquality-tags"]
            AuthStub["Auth — 501 stub\nlogin · register · OTP (S5)"]
            NoteStub["Note — 501 stub\nposts · timeline · search (S6)"]
            DriveStub["Drive — 501 stub\nSkyline Drive (S6)"]
            FollowStub["Follow — 501 stub (S6)"]
            AssetStub["Asset — 501 stub (S6)"]
        end

        Data["Verse.Data (EF Core)\nprovider follows runtime mode:\nSQLite in-memory (databaseless) · SQLite file (lite) · Npgsql (production)\ncolumn-aligned with GORM, same DB as Go side"]
        Tests["Verse.Tests (xUnit)\nScope · DataLayer · Seeder · User · GuestCodeBook · CurrentUser"]

        Api --> Shared
        Api --> DotNetModules
        DotNetModules --> Data
        Tests -.-> Data
        Tests -.-> Shared
    end

    %% ============ Go side ============
    subgraph GoSide["Go Side — Verse.Engine core services (SERVER_PORT :2048)"]
        EngineMain["cmd/verse-engine → internal/runtime\nsingle daemon entry\n(cmd/api = compat shim, cmd/worker = stub)"]
        AppPkg["internal/app\nrouter assembly + middleware chain\n/ws/timeline · /ws/notifications · /ws/global\nconnections: activitypub + neolinkage (placeholders)"]
        Mock["internal/mock\ndatabaseless mock routes"]

        subgraph GoModules["internal/module — 8 live Go modules (source of truth until S5–S8 port)"]
            direction LR
            GoAuth["auth"]
            GoUser["user"]
            GoInstance["instance"]
            GoNote["note + search"]
            GoDrive["drive"]
            GoFollow["follow"]
            GoAsset["asset"]
            GoShell["shell"]
        end

        Platform["internal/platform\nauthz · jwtx · httpx · config · mode\ndatabase (GORM) · cache · queue · mail · id"]
        Event["platform/event\nEventBus (16 workers, 100k idempotency)\n+ Valkey EventBridge (cross-node broadcast)"]
        WSPkg["platform/ws\nchannel subscriptions + push"]
        Search["platform/search\nBleve (CJK + pinyin) → VSQL (target)"]
        PkgPlaceholders["pkg/eventbus · vsql · activitypub · websocket\n(doc.go only — reserved for target layering)"]

        EngineMain --> AppPkg
        AppPkg --> GoModules
        AppPkg --> Mock
        GoModules --> Platform
        Platform --> Event
        Event --> WSPkg
        GoNote --> Search
    end

    %% ============ Infrastructure ============
    subgraph Infra["Persistence + Infrastructure (shared by both sides during migration)"]
        PG[("PostgreSQL (production mode)\nJSONB federated data\nschema via GORM / EF EnsureCreated\n(storage/migrations currently empty)")]
        SQLite[("SQLite file (lite mode)")]
        Valkey[("Valkey (Redis-compatible protocol)\ncache · token rotation\nEventBridge pub/sub · queue")]
        SearchIdx[("Bleve index\nengine data/search")]
    end

    %% ============ AAP (planned) ============
    subgraph AppEnv["App Environment — third-party AAP (planned, docs/aabp + spike-wazero)"]
        ThirdApp["Third-party App (.aap)\nmanifest + frontend/backend + assets"]
        AppSandbox["Sandboxed runtime\ngated APIs + EventBus subscribe-only\nno direct DB access"]
        ThirdApp --> AppSandbox
    end

    %% ============ Management control ============
    Runner -->|"build + supervise"| Api
    Runner -->|"build + supervise"| EngineMain
    EngineApi -.->|"engine HTTP client"| EngineMain

    %% ============ External traffic ============
    Web -->|"REST /api (primary)"| AppPkg
    Web -.->|"/api-net mirror + .NET fallback"| Api
    Web -->|"WebSocket /ws/*"| AppPkg
    AppPkg <-->|"ActivityPub (adapter placeholder)"| Fediverse

    %% ============ Data flow ============
    Platform -->|"GORM"| PG
    Platform -->|"GORM"| SQLite
    Data -->|"EF Core · shared DB, single writer per module"| PG
    Data -->|"EF Core · shared DB"| SQLite
    Event <-->|"bridge"| Valkey
    Search --> SearchIdx

    %% ============ AAP wiring (planned) ============
    ModuleMgr -.->|"install / enable .aap"| ThirdApp
    AppSandbox -.->|"subscribe-only"| Event

    %% ============ Legend ============
    subgraph Legend["Legend"]
        L1["live — running implementation"]
        L2["501 stub — pending Go→.NET port"]
        L3["placeholder — target design only"]
    end

    classDef live fill:#dcfaf7,stroke:#39C5BB,color:#064e3b
    classDef stub fill:#fff7e0,stroke:#c9a227,stroke-dasharray:5 4,color:#5c4400
    classDef planned fill:#f1e9ff,stroke:#8b5cf6,stroke-dasharray:3 3,color:#3b2d5f

    class L1,Api,Shared,InstanceDotNet,UserDotNet,ShellDotNet,MusicDotNet,Data,Tests,EngineMain,AppPkg,Mock,GoAuth,GoUser,GoInstance,GoNote,GoDrive,GoFollow,GoAsset,GoShell,Platform,Event,WSPkg,Search live
    class L2,AuthStub,NoteStub,DriveStub,FollowStub,AssetStub stub
    class L3,ThirdApp,AppSandbox,PkgPlaceholders,Fediverse planned
