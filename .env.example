SERVER_PORT=2048
VERSE_API_PORT=2050
NITRO_PORT=2000
NITRO_HOST=::

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=asagity
DB_PASSWORD=example_password
DB_NAME=asagity_db

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

POSTGRES_PORT=5432
POSTGRES_USER=asagity
POSTGRES_PASSWORD=example_password
POSTGRES_DB=asagity_db
REDIS_PORT=6379

JWT_SECRET=changeme-please-set-a-strong-secret

# Comma-separated allowed origins for CORS and WebSocket (production required).
# Dev mode defaults to http://localhost:2000,http://127.0.0.1:2000
CORS_ALLOWED_ORIGINS=http://localhost:2000,http://127.0.0.1:2000
WS_ALLOWED_ORIGINS=http://localhost:2000,http://127.0.0.1:2000

# Bootstrap administrator password (production). If unset, a random password
# is generated and printed once to stdout on first seed.
ADMIN_BOOTSTRAP_PASSWORD=

# Time zone for PostgreSQL connection (default: UTC)
TZ=UTC

# Container Configuration
# For Podman: cd container/podman && ./start.sh
# For Docker: docker compose -f container/docker/docker-compose.yaml up -d
