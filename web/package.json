{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 2000 --host ::",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 2000 --host ::",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "theme:palette": "astryx theme palette generate src/theme/yukinoshita-glacier/palette.config.json -o src/theme/yukinoshita-glacier/glacier.palette.ts --preview src/theme/yukinoshita-glacier/palette.preview.html -f",
    "theme:build": "astryx theme build src/theme/yukinoshita-glacier/yukinoshita-glacier.ts -o src/theme/yukinoshita-glacier/dist/yukinoshita-glacier.css"
  },
  "dependencies": {
    "@astryxdesign/cli": "^0.7.7",
    "@astryxdesign/core": "^0.7.7",
    "@astryxdesign/theme-neutral": "^0.7.7",
    "@fluentui/react-icons": "^2.0.345",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-query": "^5.105.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "framer-motion": "^14.9.0",
    "lrc-kit": "^1.2.1",
    "mfm-js": "^0.28.0",
    "music-metadata": "^12.3.4",
    "re-resizable": "^6.11.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.17.0",
    "react-window": "^2.5.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "ua-parser-js": "^2.0.10",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ua-parser-js": "^0.7.39",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^4.1.9"
  }
}
